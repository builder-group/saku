{
	"name": "saku",
	"private": true,
	"description": "Showcase Everything You Are and Create.",
	"keywords": [],
	"homepage": "https://saku.so/?utm_source=github",
	"bugs": {
		"url": "https://github.com/builder-group/saku/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/builder-group/saku.git"
	},
	"license": "AGPL-3.0-or-later",
	"author": "@bennobuilder",
	"scripts": {
		"build": "turbo run build",
		"clean": "turbo run clean && shx rm -rf .turbo && shx rm -rf .vercel && shx rm -rf node_modules",
		"docker:build:sfy-link-in-bio": "docker build -f devops/apps/sfy-link-in-bio-app/Dockerfile --build-arg PROJECT=@repo/sfy-link-in-bio-app -t saku-sfy-link-in-bio .",
		"docker:dev": "cd devops && docker compose up --build",
		"docker:dev:down": "cd devops && docker compose down",
		"docker:run:sfy-link-in-bio": "docker run -p 3000:3000 saku-sfy-link-in-bio",
		"fly:deploy:sfy-link-in-bio": "fly deploy -c devops/apps/sfy-link-in-bio-app/fly.toml --dockerfile devops/apps/sfy-link-in-bio-app/Dockerfile",
		"format": "prettier --write \"**/*.{ts,tsx,md,json,js,jsx}\"",
		"install:clean": "pnpm clean && pnpm install && pnpm build",
		"lint": "turbo run lint",
		"start:dev": "turbo run start:dev",
		"test": "turbo run test",
		"update:latest": "turbo run update:latest"
	},
	"devDependencies": {
		"@blgc/config": "^0.0.35",
		"@shopify/cli": "^3.81.0",
		"eslint": "^9.28.0",
		"prettier": "^3.5.3",
		"rollup": "^4.43.0",
		"rollup-presets": "^0.0.21",
		"shx": "^0.4.0",
		"tsx": "^4.20.3",
		"turbo": "^2.5.4",
		"typescript": "^5.8.3",
		"vite": "^6.3.5",
		"vitest": "^3.2.3"
	},
	"packageManager": "pnpm@10.12.1",
	"engines": {
		"node": ">=20"
	}
}
