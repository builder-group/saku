    "@shopify/shopify-app-session-storage-memory": "^4.0.20",
    "@tanstack/react-query": "^5.83.0",
    "canvas-confetti": "^1.9.3",
    "clsx": "^2.1.1",
    "feature-fetch": "^0.0.49",
    "feature-logger": "^0.0.42",
    "feature-react": "^0.0.55",
    "feature-state": "^0.0.57",
