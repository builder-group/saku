{
	"name": "@repo/sfy-link-in-bio-app",
	"version": "0.0.1",
	"private": true,
	"description": "Saku - Link In Bio Shopify App",
	"keywords": [],
	"bugs": {
		"url": "https://github.com/builder-group/saku/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/builder-group/saku.git"
	},
	"license": "AGPL-3.0-or-later",
	"author": "@bennobuilder",
	"type": "module",
	"scripts": {
		"build": "pnpm typecheck && remix vite:build",
		"clean": "shx rm -rf dist && shx rm -rf build && shx rm -rf .turbo && shx rm -rf node_modules",
		"install:clean": "pnpm run clean && pnpm install",
		"lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
		"shopify": "shopify",
		"shopify:deploy:local": "shopify app deploy -c shopify.app.local.toml",
		"shopify:deploy:prod": "shopify app deploy -c shopify.app.prod.toml",
		"start": "remix-serve ./build/server/index.js",
		"start:dev": "shopify app dev -c shopify.app.local.toml",
		"typecheck": "tsc --noEmit",
		"update:latest": "pnpm update --latest '!react' '!react-dom' '!@types/react' '!@types/react-dom'"
	},
	"dependencies": {
		"@blgc/utils": "^0.0.57",
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/modifiers": "^9.0.0",
		"@dnd-kit/sortable": "^10.0.0",
		"@mdx-js/react": "^3.1.0",
		"@remix-run/dev": "^2.16.8",
		"@remix-run/fs-routes": "^2.16.8",
		"@remix-run/node": "^2.16.8",
		"@remix-run/react": "^2.16.8",
		"@remix-run/serve": "^2.16.8",
		"@repo/api-core": "workspace:*",
		"@repo/editor": "workspace:*",
		"@repo/types": "workspace:*",
		"@shopify/app-bridge-react": "^4.2.0",
		"@shopify/polaris": "^13.9.5",
		"@shopify/polaris-icons": "^9.3.1",
		"@shopify/shopify-app-remix": "^3.8.3",
		"@shopify/shopify-app-session-storage-memory": "^4.0.18",
		"canvas-confetti": "^1.9.3",
		"clsx": "^2.1.1",
		"feature-fetch": "^0.0.48",
		"feature-logger": "^0.0.42",
		"feature-react": "^0.0.55",
		"feature-state": "^0.0.53",
		"hono": "^4.8.3",
		"isbot": "^5.1.28",
		"lucide-react": "^0.525.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-resizable-panels": "^3.0.3",
		"tailwind-merge": "^3.3.1",
		"valibot": "^1.1.0",
		"validatenv": "^0.0.38",
		"validation-adapters": "^0.0.28",
		"vite-tsconfig-paths": "^5.1.4"
	},
	"devDependencies": {
		"@mdx-js/rollup": "^3.1.0",
		"@tailwindcss/typography": "^0.5.16",
		"@tailwindcss/vite": "^4.1.11",
		"@types/canvas-confetti": "^1.9.0",
		"@types/node": "^24.0.10",
		"@types/react": "^18.3.1",
		"@types/react-dom": "^18.3.1",
		"tailwindcss": "^4.1.11"
	}
}
