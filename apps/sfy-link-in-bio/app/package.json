  "license": "AGPL-3.0-or-later",
  "author": "@bennobuilder",
  "type": "module",
  "scripts": {
    "build": "pnpm typecheck && remix vite:build",
    "build:prod": "export NODE_ENV=production && pnpm build",
    "clean": "shx rm -rf dist && shx rm -rf build && shx rm -rf .turbo && shx rm -rf node_modules",
    "install:clean": "pnpm run clean && pnpm install",
    "lint": "eslint . --fix",
    "shopify": "shopify",
    "shopify:deploy:local": "shopify app deploy -c shopify.app.local.toml",
    "shopify:deploy:prod": "shopify app deploy -c shopify.app.prod.toml",
    "start": "react-router-serve ./build/server/index.js",
    "start:dev": "shopify app dev -c shopify.app.local.toml",
    "test": "echo \"🧪 No tests defined yet.\"",
    "typecheck": "tsc --noEmit",
    "update:latest": "pnpm update --latest '!react' '!react-dom' '!@types/react' '!@types/react-dom'"
  },
  "dependencies": {
    "@blgc/utils": "^0.0.57",
