{
	"extends": "@blgc/config/typescript/react-internal",
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "dom", "dom.iterable"],
		"baseUrl": ".",
		"types": ["@react-router/node", "vite/client", "@shopify/app-bridge-ui-types"],
		"rootDirs": [".", "./.react-router/types"],
		"paths": {
			"@/*": ["./src/*"]
		},
		"plugins": [
			{
				"name": "gql.tada/ts-plugin",
				"schema": "https://shopify.dev/storefront-graphql-direct-proxy/2025-07",
				"tadaOutputLocation": "./src/environment/gql/shopify-storefront/graphql-env.d.ts"
			}
		]
	},
	"include": ["env.d.ts", "**/*.ts", "**/*.tsx", ".react-router/types/**/*", "../../../__deprecated/MappedPaintInput.tsx", "../../../__deprecated/MappedToggleInput.tsx", "../../../__deprecated/MappedColorInput.tsx", "../../../__deprecated/MappedSelectInput.tsx", "../../../__deprecated/MappedTextInput.tsx"],
	"exclude": ["node_modules"]
}
