{
	"name": "@repo/types",
	"version": "0.0.1",
	"private": true,
	"description": "Shared Typescript types",
	"keywords": [],
	"homepage": "https://saku.so/?utm_source=github",
	"bugs": {
		"url": "https://github.com/builder-group/saku/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/builder-group/saku.git"
	},
	"license": "AGPL-3.0-or-later",
	"author": "@bennobuilder",
	"exports": {
		"./api": {
			"source": "./src/api/index.ts",
			"types": "./dist/api/index.d.ts"
		},
		"./github": {
			"source": "./src/github/index.ts",
			"types": "./dist/github/index.d.ts"
		}
	},
	"typesVersions": {
		"*": {
			"api": [
				"./dist/api/index.d.ts"
			],
			"github": [
				"./dist/github/index.d.ts"
			]
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "shx rm -rf dist && rollup -c rollup.config.js",
		"build:prod": "export NODE_ENV=production && pnpm build",
		"clean": "shx rm -rf dist && shx rm -rf .turbo && shx rm -rf node_modules",
		"install:clean": "pnpm run clean && pnpm install",
		"lint": "eslint . --fix",
		"openapi:generate": "pnpm run openapi:generate:api && pnpm run openapi:generate:github",
		"openapi:generate:api": "npx openapi-typescript --redocly ./src/api/resources/redocly.yaml",
		"openapi:generate:github": "npx openapi-typescript --redocly ./src/github/resources/redocly.yaml",
		"redocly": "npx @redocly/cli",
		"test": "echo \"🧪 No tests defined yet.\"",
		"update:latest": "pnpm update --latest"
	},
	"devDependencies": {
		"@redocly/cli": "^2.8.0",
		"openapi-typescript": "^7.10.1"
	}
}
