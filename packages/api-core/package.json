{
	"name": "@repo/api-core",
	"version": "0.0.1",
	"private": true,
	"description": "Core API",
	"keywords": [],
	"homepage": "https://saku.so/?utm_source=github",
	"bugs": {
		"url": "https://github.com/builder-group/saku/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/builder-group/saku.git"
	},
	"license": "AGPL-3.0-or-later",
	"author": "@bennobuilder",
	"main": "./dist/cjs/index.js",
	"module": "./dist/esm/index.js",
	"source": "./src/index.ts",
	"types": "./dist/types/index.d.ts",
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "shx rm -rf dist && rollup -c rollup.config.js",
		"build:prod": "export NODE_ENV=production && pnpm build",
		"clean": "shx rm -rf dist && shx rm -rf .turbo && shx rm -rf node_modules",
		"db:generate:local": "drizzle-kit generate --config drizzle-local.config.js",
		"db:generate:prod": "drizzle-kit generate --config drizzle-prod.config.js",
		"db:migrate:local": "node ./drizzle/migrate.js --local",
		"db:migrate:prod": "node ./drizzle/migrate.js",
		"install:clean": "pnpm run clean && pnpm install",
		"lint": "eslint . --fix",
		"start:dev": "tsx watch ./dev.js",
		"test": "vitest run",
		"update:latest": "pnpm update --latest '!@types/react'"
	},
	"dependencies": {
		"@blgc/utils": "^0.0.61",
		"@heymantle/client": "^1.1.70",
		"@hono/zod-openapi": "1.2.0",
		"@hono/zod-validator": "^0.7.6",
		"@repo/editor": "workspace:*",
		"@repo/hono-utils": "workspace:*",
		"@repo/transactional": "workspace:*",
		"@shopify/shopify-api": "^12.2.0",
		"@upstash/redis": "^1.36.1",
		"drizzle-orm": "^0.45.1",
		"drizzle-zod": "^0.8.3",
		"feature-fetch": "^0.0.54",
		"feature-logger": "^0.0.46",
		"gql.tada": "^1.9.0",
		"head-metadata": "0.0.11",
		"hono": "^4.11.4",
		"jose": "^6.1.3",
		"pg": "^8.17.1",
		"pika-id": "^1.1.3",
		"resend": "^6.7.0",
		"strip-json-comments": "^5.0.3",
		"tuple-result": "^0.0.11",
		"valibot": "^1.2.0",
		"validatenv": "^0.0.43",
		"validation-adapters": "^0.0.37",
		"xml-tokenizer": "^0.0.44",
		"zod": "4.3.5"
	},
	"devDependencies": {
		"@hono/node-server": "^1.19.9",
		"@rollup/plugin-replace": "^6.0.3",
		"@types/node": "^25.0.8",
		"@types/pg": "^8.16.0",
		"@types/react": "^18.3.1",
		"drizzle-kit": "^0.31.8",
		"minimist": "^1.2.8"
	}
}
